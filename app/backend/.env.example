# Copy this file to .env (same folder) and fill in the values. .env is git-ignored.

# Supabase dashboard -> Project Settings -> API -> Project URL. No /rest/v1, no trailing slash.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Supabase dashboard -> Project Settings -> API Keys -> secret key (sb_secret_...) or legacy service_role key.
# This key bypasses Row Level Security: keep it on the server only, never in the frontend or firmware.
SUPABASE_SECRET_KEY=

PORT=3001
